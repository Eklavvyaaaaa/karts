{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node"],
    "typeRoots": ["../client/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts"]
}
